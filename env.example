# Folio Unraid worker — same knobs as 9-FS/nhentai_archivist, plus API v2 extras.
# Copy to /app/config/.env or set them as container environment variables.

# --- required for the scheduled loop (server mode) ---
# Leave empty for a one-shot run of downloadme.txt (client mode).
NHENTAI_TAGS=language:"english"
SLEEP_INTERVAL=3600

# --- library ---
LIBRARY_PATH=/app/hentai/
LIBRARY_SPLIT=10000
FILENAME_TITLE_TYPE=English
DOWNLOADME_FILEPATH=/app/config/downloadme.txt
DONTDOWNLOADME_FILEPATH=/app/config/dontdownloadme.txt

# --- network ---
DOWNLOAD_WORKERS=5
CIRCUMVENT_LOAD_BALANCER=true
USER_AGENT=Folio/1.0 (nhentai API v2 archivist; +https://nhentai.net/api/v2/docs)
# API_KEY=
# COOKIE=

# --- behavior ---
CLEANUP_TEMPORARY_FILES=true
SAFETY_FILTER=true
CATCH_UP_STREAK=50
MAX_PER_CYCLE=0
REQUEST_DELAY_MS=2000
MAX_SEARCH_PAGES=0
SEARCH_SORT=date
DRY_RUN=false
RUN_ONCE=false
DEBUG=false
STATUS_PORT=8099

# --- Unraid ---
PUID=99
PGID=100
UMASK=002
TZ=America/New_York
